<Page
    x:Class="Machine.SoftPartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Ir77X="using:Ir77X"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Ir77X.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="6,6,6,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <Ir77X:UserFilterHVID 
                x:Name="SoftPartitionHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="SoftPartition HVID"/>

            <Ir77X:UserFilterNewItem 
                x:Name="SoftPartitionName"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Tag"/>

            <Ir77X:UserFilterItem 
                x:Name="SoftPartitionFormat"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Format"/>

            <Ir77X:UserChrono 
                x:Name="SoftPartitionCreated"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Created"/>

            <Ir77X:UserChrono 
                x:Name="SoftPartitionUpdated"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Updated"/>

            <Ir77X:UserChrono 
                x:Name="SoftPartitionOpened"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Opened"/>

            <Ir77X:UserBlock 
                x:Name="Ir77VOLOFF"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1" 
                Label="$Ir77VOL Offset"/>

            <Ir77X:UserBlock 
                x:Name="Ir77VOLSZ"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1" 
                Label="$Ir77VOL Size"/>

            <Ir77X:UserBlock 
                x:Name="Ir77SFTOFF"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1" 
                Label="$Ir77SFT Offset"/>

            <Ir77X:UserBlock 
                x:Name="Ir77SFTSZ"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1" 
                Label="$Ir77SFT Size"/>

            <Ir77X:UserBlock 
                x:Name="Ir77MIROFF"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="$Ir77MIR Offset"/>

            <Ir77X:UserBlock 
                x:Name="Ir77MIRSZ"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="$Ir77MIR Size"/>

            <Ir77X:UserBlock 
                x:Name="Ir77ATTOFF"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="6" Grid.RowSpan="1" 
                Label="$Ir77ATT Offset"/>

            <Ir77X:UserBlock 
                x:Name="Ir77ATTSZ"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="6" Grid.RowSpan="1" 
                Label="$Ir77ATT Size"/>

            <Ir77X:UserBlock 
                x:Name="Ir77BMPOFF"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="7" Grid.RowSpan="1" 
                Label="$Ir77BMP Offset"/>

            <Ir77X:UserBlock 
                x:Name="Ir77BMPSZ"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="7" Grid.RowSpan="1"
                Label="$Ir77BMP Size"/>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="8" Grid.RowSpan="1"/>

            <Border 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="9" Grid.RowSpan="1"
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1">

                <TextBox 
                    Foreground="Black"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontWeight="Medium"
                    FontSize="12"
                    Padding="3,3,3,3"
                    PlaceholderText="Add description here ..."
                    ScrollViewer.VerticalScrollBarVisibility="Visible"/>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>

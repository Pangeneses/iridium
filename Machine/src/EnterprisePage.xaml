<Page
    x:Class="Machine.EnterprisePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Ir77X="using:Ir77X"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Ir77X.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="6,6,6,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <Ir77X:UserBlock
                x:Name="EnterpriseName"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1"
                Label="Enterprise Name"/>

            <Ir77X:UserBlock
                x:Name="EnterpriseHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1"
                Label="HVID"/>

            <Ir77X:UserChrono
                x:Name="EnterpriseRegistered"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1"
                Label="Registered"/>

            <Ir77X:UserChrono 
                x:Name="EnterpriseUpdated"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1"
                Label="Updated"/>

            <Ir77X:UserFilterItem
                x:Name="EnterpriseLocalization"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1"
                Label="Localization"/>

            <Ir77X:UserFilterItem
                x:Name="EnterpriseTimeZone"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1"
                Label="Time Zone"/>

            <Ir77X:UserFilterItem
                x:Name="EnterpriseKeyboard"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1"
                Label="Keyboard"/>

            <Ir77X:UserFilterItem
                x:Name="EnterpriseWindowsTarget"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1"
                Label="Windows Target"/>

            <Ir77X:UserPicker
                x:Name="EnterpriseExecutableDir"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="4" Grid.RowSpan="1"
                Label="Executable Dir"/>

            <Ir77X:UserPicker 
                x:Name="EnterpriseAssetsDir"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="5" Grid.RowSpan="1"
                Label="Assets Dir"/>

            <Ir77X:UserPicker
                x:Name="EnterpriseXamlDir"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="6" Grid.RowSpan="1"
                Label="Xaml Dir"/>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="7" Grid.RowSpan="1"/>

            <Border 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="8" Grid.RowSpan="1"
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1">

                <TextBox 
                    Foreground="Black"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontWeight="Medium"
                    FontSize="12"
                    Padding="3,3,3,3"
                    PlaceholderText="Add description here ..."
                    ScrollViewer.VerticalScrollBarVisibility="Visible"/>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>

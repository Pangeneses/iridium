<Page
    x:Class="Machine.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Ir77X="using:Ir77X"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Ir77X.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="6,6,6,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <Ir77X:UserFilterHVID 
                x:Name="LibraryHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Library HVID"/>

            <Ir77X:UserFilterMMM 
                x:Name="LibraryMMM"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="MMM"/>

            <Ir77X:UserFilterNewItem 
                x:Name="LibraryMaxPath"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Tag"/>

            <Ir77X:UserBlock 
                x:Name="LibraryNamespace"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1"
                Label="Namespace"/>

            <Ir77X:UserPicker 
                x:Name="LibraryDL"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1"
                Label="DL"/>

            <Ir77X:UserChrono 
                x:Name="LibraryCompiled"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1"
                Label="Compiled"/>

            <Ir77X:UserChrono 
                x:Name="LibraryInstalled"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1"
                Label="Installed"/>

            <Ir77X:UserChrono 
                x:Name="LibraryUpdated"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1"
                Label="Updated"/>

            <Ir77X:UserBlock 
                x:Name="LibraryAccessLevel"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1" 
                Label="Access Level"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="PERMISSIONS"
                        FontSize="12"/>
                </Button>

            </Border>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="5" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="MANUAL PAGES"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="6" Grid.RowSpan="1"/>

            <Ir77X:UserEntry 
                x:Name="Contact"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="7" Grid.RowSpan="1"
                Label="Contact"/>

            <Ir77X:UserEntry 
                x:Name="ContactAddressOne"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="8" Grid.RowSpan="1"
                Label="Address One"/>

            <Ir77X:UserEntry 
                x:Name="ContactAddressTwo"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="9" Grid.RowSpan="1"
                Label="Address Two"/>

            <Ir77X:UserEntry 
                x:Name="ContactCity"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="10" Grid.RowSpan="1"
                Label="City"/>

            <Ir77X:UserEntry 
                x:Name="ContactRegion"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="11" Grid.RowSpan="1"
                Label="Region"/>

            <Ir77X:UserEntry 
                x:Name="ContactPostalCode"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="11" Grid.RowSpan="1"
                Label="Postal Code"/>

            <Ir77X:UserEntry 
                x:Name="ContactEMail"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="12" Grid.RowSpan="1"
                Label="EMail"/>

            <Ir77X:UserEntry 
                x:Name="ContactPrimaryPhone"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="13" Grid.RowSpan="1"
                Label="Primary Phone"/>

            <Ir77X:UserEntry 
                x:Name="ContactSecondaryPhone"
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="14" Grid.RowSpan="1"
                Label="Secondary Phone"/>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="15" Grid.RowSpan="1"/>

            <Border 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="16" Grid.RowSpan="1"
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1">

                <TextBox 
                    Foreground="Black"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontWeight="Medium"
                    FontSize="12"
                    Padding="3,3,3,3"
                    PlaceholderText="Add description here ..."
                    ScrollViewer.VerticalScrollBarVisibility="Visible"/>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>
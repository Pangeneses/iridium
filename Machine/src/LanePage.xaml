<Page
    x:Class="Machine.LanePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Ir77X="using:Ir77X"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Ir77X.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="6,6,6,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <Ir77X:UserFilterGoToHVID 
                x:Name="LibraryHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Library HVID"/>

            <Ir77X:UserBlock
                x:Name="LibraryNamespace"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Library Namespace"/>

            <Ir77X:UserBlock 
                x:Name="LibraryDL"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Library DL"/>

            <Ir77X:UserFilterHVID 
                x:Name="DictionaryHVID"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Dictionary HVID"/>

            <Ir77X:UserFilterItem 
                x:Name="DictionaryName"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Dictionary Name"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1"
                Grid.Row="2" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="MANUAL PAGES"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="3" Grid.RowSpan="1"/>

            <Ir77X:UserBlock 
                x:Name="LaneHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1" 
                Label="Lane HVID"/>

            <Ir77X:UserBlock
                x:Name="LaneName"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="Lane Name"/>

            <Ir77X:UserFilterMemberOf 
                x:Name="LaneList"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="6" Grid.RowSpan="1" 
                Label="Registered Lane number:"/>

            <Ir77X:UserFilterItem 
                x:Name="CollectionHVID"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1" 
                Label="Collection HVID"/>

            <Ir77X:UserFilterItem 
                x:Name="CollectionName"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="Collection Name"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1"
                Grid.Row="6" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="MANUAL PAGES"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="7" Grid.RowSpan="1"/>

            <Ir77X:UserBlock 
                x:Name="OperationHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="8" Grid.RowSpan="1" 
                Label="Operation HVID"/>

            <Ir77X:UserBlock
                x:Name="OperationName"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="9" Grid.RowSpan="1" 
                Label="Operation Name"/>

            <Ir77X:UserFilterMemberOf 
                x:Name="DependencyListFilter"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="10" Grid.RowSpan="1" 
                Label="Operation number:"/>

            <Ir77X:UserBlock 
                x:Name="OperationCollectionHVID"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="8" Grid.RowSpan="1" 
                Label="Operation Collection HVID"/>

            <Ir77X:UserBlock 
                x:Name="OperationCollectionName"
                Grid.Column="15" Grid.ColumnSpan="1" 
                Grid.Row="9" Grid.RowSpan="1" 
                Label="Operation Collection Name"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1"
                Grid.Row="10" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="GOTO DICTIONARY"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="11" Grid.RowSpan="1"/>

            <Border 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="12" Grid.RowSpan="1"
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1">

                <TextBox 
                    Foreground="Black"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontWeight="Medium"
                    FontSize="12"
                    Padding="3,3,3,3"
                    PlaceholderText="Add description here ..."
                    ScrollViewer.VerticalScrollBarVisibility="Visible"/>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>
<Page
    x:Class="Machine.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Ir77X="using:Ir77X"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Ir77X.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="6,6,6,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <Ir77X:UserFilterHVID 
                x:Name="HardwareManufacturer"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Hardware Manufacturer"/>

            <Ir77X:UserBlock 
                x:Name="HardwareModelHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Model S/N"/>

            <Ir77X:UserBlock 
                x:Name="HardwareModelMaxPath"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Model"/>

            <Ir77X:UserHVID 
                x:Name="HardwareHVID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1" 
                Label="HVID"/>

            <Ir77X:UserFilterItem 
                x:Name="HardwareID"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1" 
                Label="ID"/>

            <Ir77X:UserFilterNewItem 
                x:Name="HardwareMaxPath"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="Tag"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="0" Grid.ColumnSpan="1" 
                Grid.Row="6" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="MANUAL PAGES"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserChrono 
                x:Name="HardwareBuilt"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="0" Grid.RowSpan="1" 
                Label="Built"/>

            <Ir77X:UserChrono 
                x:Name="HardwareInstalled"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="1" Grid.RowSpan="1" 
                Label="Installed"/>

            <Ir77X:UserChrono 
                x:Name="HardwareUpdated"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="2" Grid.RowSpan="1" 
                Label="Updated"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="3" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="MAPPINGS"
                        FontSize="12"/>
                </Button>

            </Border>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="4" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="DIAGNOSE"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserBlock 
                x:Name="HardwareAccessLevel"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="5" Grid.RowSpan="1" 
                Label="Access Level"/>

            <Border 
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1"
                Grid.Column="1" Grid.ColumnSpan="1" 
                Grid.Row="6" Grid.RowSpan="1">

                <Button 
                    BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                    BorderThickness="1"
                    Margin="2,2,2,2"
                    Padding="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBlock 
                        Text="PERMISSIONS"
                        FontSize="12"/>
                </Button>

            </Border>

            <Ir77X:UserDivider 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="7" Grid.RowSpan="1"/>

            <Border 
                Grid.Column="0" Grid.ColumnSpan="2" 
                Grid.Row="8" Grid.RowSpan="1"
                BorderBrush="{ThemeResource hv4DButtonBorderStandard}"
                BorderThickness="1">

                <TextBox 
                    Foreground="Black"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontWeight="Medium"
                    FontSize="12"
                    Padding="3,3,3,3"
                    PlaceholderText="Add description here ..."
                    ScrollViewer.VerticalScrollBarVisibility="Visible"/>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>
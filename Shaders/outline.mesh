#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

#include "include/bindless.glsl"
#include "include/outline.glsl"

// The outline's shell on the mesh path -- mesh.mesh's meshlets (mesh.task, told to keep the back-facing ones), positions pushed out along
// their normals. max_vertices / max_primitives must match MESHLET_MAX_VERTICES / MESHLET_MAX_TRIANGLES, the structs mesh.task's.
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

// pc.user[0] -- matches Ir77PVMeshlet (64 bytes)
struct Meshlet {
    vec4 sphere;
    vec4 cone;
    uint vertex_offset;
    uint triangle_offset;
    uint vertex_count;
    uint triangle_count;
    uint material;
    uint pad0;
    uint pad1;
    uint pad2;
};
IR77_BUFFER(ir77_meshlets, Meshlet);

// pc.user[1] -- meshlet-local index -> mesh vertex index
IR77_BUFFER(ir77_meshlet_vertices, uint);

// pc.user[2] -- uint8 x3 per triangle, read as packed words
IR77_BUFFER(ir77_meshlet_triangles, uint);

// pc.vertices -- Ir77PVVertex as 12 tightly packed floats: position xyz, normal xyz, uv, tangent xyzw
IR77_BUFFER(ir77_vertex_floats, float);

const uint VERTEX_FLOATS = 12u;

// must match mesh.task
struct TaskPayload {
    uint instance;
    uint meshlets[32];
};

taskPayloadSharedEXT TaskPayload payload;

uint TriangleByte(uint byte_index) {
    return (ir77_meshlet_triangles[pc.user[2]].data[byte_index >> 2] >> ((byte_index & 3u) * 8u)) & 0xFFu;
}

float VertexFloat(uint index) {
    return ir77_vertex_floats[pc.vertices].data[index];
}

void main() {
    uint lane = gl_LocalInvocationIndex;

    Meshlet meshlet = ir77_meshlets[pc.user[0]].data[payload.meshlets[gl_WorkGroupID.x]];

    SetMeshOutputsEXT(meshlet.vertex_count, meshlet.triangle_count);

    mat4 model = IR77_MODEL(payload.instance);
    mat4 view_proj = IR77_CAMERA.view_proj;
    mat3 normal_matrix = mat3(model);

    for (uint i = lane; i < meshlet.vertex_count; i += 32) {
        uint base = ir77_meshlet_vertices[pc.user[1]].data[meshlet.vertex_offset + i] * VERTEX_FLOATS;

        vec3 position = vec3(VertexFloat(base + 0), VertexFloat(base + 1), VertexFloat(base + 2));
        vec3 normal = vec3(VertexFloat(base + 3), VertexFloat(base + 4), VertexFloat(base + 5));

        gl_MeshVerticesEXT[i].gl_Position = Ir77OutlinePlace(view_proj * (model * vec4(position, 1.0)), normal_matrix * normal);
    }

    for (uint t = lane; t < meshlet.triangle_count; t += 32) {
        uint byte_index = meshlet.triangle_offset + t * 3u;

        gl_PrimitiveTriangleIndicesEXT[t] = uvec3(TriangleByte(byte_index), TriangleByte(byte_index + 1u), TriangleByte(byte_index + 2u));
    }
}

#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

#include "include/bindless.glsl"

// One invocation per meshlet. Culls against the frustum and the meshlet's normal cone, then emits
// one mesh workgroup per survivor. local_size_x must match TASK_GROUP_SIZE in Ir77PVCmdBuffer.
layout(local_size_x = 32) in;

// pc.user[0] -- matches Ir77PVMeshlet (48 bytes)
struct Meshlet {
    vec4 sphere;  // xyz center, w radius -- object space
    vec4 cone;    // xyz axis, w cutoff
    uint vertex_offset;
    uint triangle_offset;
    uint vertex_count;
    uint triangle_count;
};
IR77_BUFFER(ir77_meshlets, Meshlet);

// pc.user[3] -- matches Ir77PVMeshDraw (16 bytes). One record per object drawn.
struct MeshDraw {
    uint instance;        // slot in the instance table
    uint meshlet_offset;  // first meshlet of this object
    uint meshlet_count;
    uint pad;
};
IR77_BUFFER(ir77_mesh_draws, MeshDraw);

// Direct draw: pc.draw_base = the object's record, gl_DrawID = 0.
// Indirect draw: pc.draw_base = first record of the run, gl_DrawID = 0..indirect_count-1.

// must be declared identically in mesh.mesh
struct TaskPayload {
    uint instance;  // so the mesh shader doesn't look the record up again
    uint meshlets[32];
};

taskPayloadSharedEXT TaskPayload payload;

shared uint visible_count;

bool PlaneVisible(vec4 plane, vec3 center, float radius) {
    return dot(plane.xyz, center) + plane.w >= -radius * length(plane.xyz);
}

// Gribb-Hartmann: planes from the rows of view_proj; Vulkan depth is 0..1, so near is row 2 alone
bool FrustumVisible(mat4 view_proj, vec3 center, float radius) {
    mat4 m = transpose(view_proj);

    return PlaneVisible(m[3] + m[0], center, radius) &&  // left
           PlaneVisible(m[3] - m[0], center, radius) &&  // right
           PlaneVisible(m[3] + m[1], center, radius) &&  // top / bottom
           PlaneVisible(m[3] - m[1], center, radius) &&
           PlaneVisible(m[2], center, radius) &&         // near
           PlaneVisible(m[3] - m[2], center, radius);    // far
}

// meshoptimizer's cone test -- true when every triangle in the meshlet faces away from the eye
bool ConeCulled(vec3 eye, vec3 center, float radius, vec3 axis, float cutoff) {
    vec3 to_center = center - eye;

    return dot(to_center, axis) >= cutoff * length(to_center) + radius;
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint index = gl_GlobalInvocationID.x;

    MeshDraw draw = ir77_mesh_draws[pc.user[3]].data[pc.draw_base + gl_DrawID];
    mat4 model = IR77_MODEL(draw.instance);

    if (lane == 0) {
        visible_count = 0;
        payload.instance = draw.instance;
    }

    memoryBarrierShared();
    barrier();

    if (index < draw.meshlet_count) {
        uint meshlet_index = draw.meshlet_offset + index;
        Meshlet meshlet = ir77_meshlets[pc.user[0]].data[meshlet_index];

        Ir77Camera camera = IR77_CAMERA;

        // object -> world. Radius scales by the largest axis so non-uniform scale stays conservative.
        vec3 center = (model * vec4(meshlet.sphere.xyz, 1.0)).xyz;
        float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));
        float radius = meshlet.sphere.w * scale;
        vec3 axis = normalize(mat3(model) * meshlet.cone.xyz);

        bool visible = FrustumVisible(camera.view_proj, center, radius) && !ConeCulled(camera.eye.xyz, center, radius, axis, meshlet.cone.w);

        if (visible) {
            uint slot = atomicAdd(visible_count, 1);
            payload.meshlets[slot] = meshlet_index;
        }
    }

    memoryBarrierShared();
    barrier();

    EmitMeshTasksEXT(visible_count, 1, 1);
}
